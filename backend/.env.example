# Supabase project credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to verify Supabase JWTs (found in Project Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=your-jwt-secret

# Gemini API key (Google AI Studio → API Keys)
GEMINI_API_KEY=your-gemini-api-key

# Supabase Storage bucket name for resume files
RESUME_BUCKET=resumes

# TODO: Real email delivery via SendGrid (leave blank to skip actual send, messages still logged)
SENDGRID_API_KEY=

# TODO: Real SMS delivery via Twilio (leave blank to skip actual send)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# App
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
